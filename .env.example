# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore: nunca se commitea.

# ── Supabase (obligatorio) ────────────────────────────────────────────
# Project Settings > API, en el dashboard de Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── IA (opcional) ─────────────────────────────────────────────────────
# La app no depende de un proveedor concreto: `AIService` describe lo
# que necesita y cada proveedor lo implementa (ver
# src/services/aiProvider.ts).
#
# Sin ninguna clave la app arranca igual; lo que falla, con un mensaje
# claro, es generar diseños, recortar fondos y componer sobre una foto.
#
# Con qué proveedor trabajar. Si se deja vacío, se usa el primero que
# tenga clave: openai, y si no, gemini.
EXPO_PUBLIC_AI_PROVIDER=openai

# platform.openai.com > API keys. Requiere saldo en la cuenta, y para
# el modelo de imagen suele hacer falta verificar la organización.
EXPO_PUBLIC_OPENAI_API_KEY=

# aistudio.google.com > Get API key.
EXPO_PUBLIC_GEMINI_API_KEY=
