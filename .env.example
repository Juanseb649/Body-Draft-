# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore: nunca se commitea.

# ── Supabase (obligatorio) ────────────────────────────────────────────
# Project Settings > API, en el dashboard de Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── IA ────────────────────────────────────────────────────────────────
# La app YA NO lleva ninguna clave de IA. Todo lo que es EXPO_PUBLIC_
# termina dentro de la app y cualquiera lo puede sacar, así que la
# clave del proveedor vive en los secrets de Supabase y la usa la Edge
# Function `ai` (supabase/functions/ai), con una cuota diaria por cuenta:
#
#   npx supabase secrets set OPENAI_API_KEY=sk-...      (o GEMINI_API_KEY=...)
#   npx supabase secrets set AI_PROVIDER=openai AI_DAILY_LIMIT=10
#   npx supabase functions deploy ai
#
# No pongas aquí EXPO_PUBLIC_OPENAI_API_KEY ni EXPO_PUBLIC_GEMINI_API_KEY.
